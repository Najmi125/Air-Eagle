# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Production/dev database (Air Eagle's own Neon or Supabase project —
# per platform policy, physically isolated, never shared with another
# airline client)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Separate database used only by the test suite (tests/conftest.py).
# Tests DROP and recreate the public schema on this database on every
# run — never point this at anything with real data.
TEST_DATABASE_URL=postgresql://user:password@host:5432/dbname_test
