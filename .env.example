# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Production/dev database (Air Eagle's own Neon or Supabase project —
# per platform policy, physically isolated, never shared with another
# airline client)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Separate database used only by the test suite (tests/conftest.py).
# Tests DROP and recreate the public schema on this database on every
# run — never point this at anything with real data.
#
# Left genuinely EMPTY on purpose, not a placeholder string like
# DATABASE_URL above: conftest.py's db_engine fixture skips
# DB-dependent tests when this is unset, via `if not test_url`. A
# well-formed-looking placeholder (e.g. postgresql://user:password@host...)
# is a non-empty string, so that check never triggers — pytest then
# tries to actually connect to a literal host named "host", which
# hangs rather than failing fast or skipping. Confirmed as a real
# bug that blocked a real user twice before being fixed here — if
# you need to actually run the test suite yourself, point this at a
# real disposable Postgres instance; otherwise leave it empty and
# those tests will skip cleanly.
TEST_DATABASE_URL=
